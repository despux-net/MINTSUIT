{%- comment -%}
  What the panel says about each Printful product, read by the
  mintsuit-shop function so a product switched to Sold out can't be bought
  even from an old copy of the page.
{%- endcomment -%}
{"products": [
{%- for p in site.data.shop.products %}
  {"name": {{ p.name | jsonify }}, "printful_id": {{ p.printful_id | default: 0 | jsonify }}, "title": {{ p.title | default: "" | jsonify }}, "available": {% if p.available == nil or p.available == "" %}null{% else %}{{ p.available | jsonify }}{% endif %}, "sold_out": {% if p.sold_out %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]}
